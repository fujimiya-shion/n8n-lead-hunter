# ===== Lead Hunter =====
# Copy thành .env rồi điền giá trị:  cp .env.example .env
# Chỉ chứa hạ tầng và bí mật. Cấu hình chạy (ngành, khu vực, số lead, ngân sách Apify)
# nằm trong bảng `settings`, `industries`, `locations` của DB → sửa qua NocoDB.
TZ=Asia/Ho_Chi_Minh

# PostgreSQL
POSTGRES_USER=leadhunter
# Tạo bằng: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=leads

# n8n: khoá mã hoá credential. Tạo bằng: openssl rand -hex 24
# KHÔNG đổi sau khi đã chạy, nếu đổi credential trong n8n sẽ hỏng
N8N_ENCRYPTION_KEY=

# gosom/google-maps-scraper: số tab Chrome chạy song song
GMAPS_CONCURRENCY=4

# Apify Personal API token (console.apify.com → Settings → API & Integrations)
APIFY_TOKEN=

# ===== Cổng mở ra máy host (chỉ 127.0.0.1). Đổi nếu đụng cổng với container khác =====
FORWARD_POSTGRES_PORT=5433
FORWARD_N8N_PORT=5678
FORWARD_GMAPS_PORT=8081
FORWARD_NOCODB_PORT=8090
FORWARD_METABASE_PORT=3000

# ===== Lịch tự chạy (systemd: đánh thức máy → chạy job → ngủ lại) =====
# Giờ chạy, nhiều giờ cách nhau dấu phẩy, vd "09:00,13:00,17:00". Đổi xong chạy: scripts/install-scheduler.sh
SCHEDULE_TIMES=23:00
# Đang dùng pin dưới % này thì bỏ qua lượt chạy
SCHEDULE_MIN_BATTERY=30
# Chờ thu kết quả tối đa bao nhiêu phút rồi cho máy ngủ lại (job chưa xong sẽ thu ở lần thức sau)
SCHEDULE_MAX_WAIT_MIN=120
