# ===== Lead Hunter =====
# Copy thành .env rồi điền giá trị:  cp .env.example .env
# Chỉ chứa hạ tầng và bí mật. Cấu hình chạy (ngành, khu vực, số lead, ngân sách Apify)
# nằm trong bảng `settings`, `industries`, `locations` của DB → sửa qua NocoDB.
TZ=Asia/Ho_Chi_Minh

# PostgreSQL
POSTGRES_USER=leadhunter
# Tạo bằng: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=leads

# n8n: khoá mã hoá credential. Tạo bằng: openssl rand -hex 24
# KHÔNG đổi sau khi đã chạy, nếu đổi credential trong n8n sẽ hỏng
N8N_ENCRYPTION_KEY=

# gosom/google-maps-scraper: số tab Chrome chạy song song
GMAPS_CONCURRENCY=4

# Apify Personal API token (console.apify.com → Settings → API & Integrations)
APIFY_TOKEN=

# ===== Cổng mở ra máy host (chỉ 127.0.0.1). Đổi nếu đụng cổng với container khác =====
FORWARD_POSTGRES_PORT=5433
FORWARD_N8N_PORT=5678
FORWARD_GMAPS_PORT=8081
FORWARD_NOCODB_PORT=8090
FORWARD_METABASE_PORT=3000

# ===== Lịch tự chạy (systemd: đánh thức máy → chạy job → ngủ lại) =====
# Giờ chạy, nhiều giờ cách nhau dấu phẩy, vd "09:00,13:00,17:00". Đổi xong chạy: scripts/install-scheduler.sh
SCHEDULE_TIMES=23:00
# Đang dùng pin dưới % này thì bỏ qua lượt chạy
SCHEDULE_MIN_BATTERY=30
# Chờ thu kết quả tối đa bao nhiêu phút rồi cho máy ngủ lại (job chưa xong sẽ thu ở lần thức sau)
SCHEDULE_MAX_WAIT_MIN=120

# ===== LLM: sinh demo web + tin nhắn chào hàng (service studio) =====
# Provider nào cũng được miễn tương thích OpenAI Chat Completions. Ví dụ:
#   Xiaomi MiMo (đang dùng): LLM_BASE_URL=https://api.xiaomimimo.com/v1  (key sk-…; gói Token Plan key tp-… dùng https://token-plan-cn.xiaomimimo.com/v1)
#                            LLM_MODEL=mimo-v2.6-flash
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1                               LLM_MODEL=deepseek-chat
#   Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1                            LLM_MODEL=<tên model>
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-flash
# Model chấm điểm tin nhắn/demo (nhẹ, rẻ hơn). Để trống = dùng LLM_MODEL
LLM_JUDGE_MODEL=
# Suy luận của model: disabled (nhanh, rẻ — mặc định) | enabled | off (không gửi tham số, cho provider không hỗ trợ)
LLM_THINKING=disabled
FORWARD_STUDIO_PORT=8082

# ===== Ảnh thật cho demo (studio) =====
# Thử lần lượt: Pixabay → Unsplash → Pexels → Openverse (không cần key, chỉ ảnh CC0) → hình minh hoạ vector
# Pixabay: https://pixabay.com/api/docs/ (đăng ký là có key)  ·  Unsplash: https://unsplash.com/developers (Access Key)
# Pexels: hiện tạm ngừng cấp key mới
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Openverse không cần key nhưng hay quá tải; đặt false để tắt
OPENVERSE_ENABLED=true
