{
  "id": "LhFbSearchColl01",
  "name": "06 · Facebook: tìm lead mới - thu kết quả (Apify)",
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Asia/Ho_Chi_Minh" },
  "nodes": [
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000001",
      "name": "Chạy thủ công",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000002",
      "name": "5 phút/lần (23h–5h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "*/5 23,0-5 * * *" } ] }
      }
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000003",
      "name": "Run đang chạy",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 100],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS job_id, external_id\nFROM crawl_jobs\nWHERE status = 'running' AND source = 'apify_facebook' AND external_id IS NOT NULL\nORDER BY id;",
        "options": {}
      },
      "credentials": { "postgres": { "id": "LhLeadsPostgres1", "name": "Leads Postgres" } }
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000004",
      "name": "Hỏi trạng thái run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100],
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "=https://api.apify.com/v2/actor-runs/{{ $json.external_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.APIFY_TOKEN }}" } ]
        },
        "options": { "timeout": 20000 }
      }
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000005",
      "name": "Theo trạng thái",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [720, 100],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "xong",
              "renameOutput": true,
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "combinator": "and",
                "conditions": [
                  { "id": "r1", "leftValue": "={{ $json.data?.status }}", "rightValue": "SUCCEEDED", "operator": { "type": "string", "operation": "equals" } }
                ]
              }
            },
            {
              "outputKey": "lỗi",
              "renameOutput": true,
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "combinator": "and",
                "conditions": [
                  { "id": "r2", "leftValue": "={{ $json.data?.status ?? '' }}", "rightValue": "^(FAILED|ABORTED|TIMED-OUT)$", "operator": { "type": "string", "operation": "regex" } }
                ]
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000006",
      "name": "Tải kết quả",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "=https://api.apify.com/v2/datasets/{{ $json.data.defaultDatasetId }}/items?clean=true&format=json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.APIFY_TOKEN }}" } ]
        },
        "options": {
          "timeout": 60000,
          "response": { "response": { "responseFormat": "text", "outputPropertyName": "data" } }
        }
      }
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000007",
      "name": "Lưu lead vào DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1200, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ingest_facebook_search($1::bigint, $2::jsonb, $3::numeric) AS result;",
        "options": {
          "queryReplacement": "={{ [ $('Run đang chạy').item.json.job_id, $json.data, $('Hỏi trạng thái run').item.json.data.usageTotalUsd ?? 0 ] }}"
        }
      },
      "credentials": { "postgres": { "id": "LhLeadsPostgres1", "name": "Leads Postgres" } }
    },
    {
      "id": "f1b2c3d4-0006-4000-8000-000000000008",
      "name": "Đánh dấu job lỗi",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1200, 240],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE crawl_jobs SET status = 'failed', error = left($2, 2000), cost_usd = $3::numeric, finished_at = now() WHERE id = $1::bigint;",
        "options": {
          "queryReplacement": "={{ [ $('Run đang chạy').item.json.job_id, JSON.stringify($json.error ?? $json.data?.statusMessage ?? $json), $('Hỏi trạng thái run').item.json.data?.usageTotalUsd ?? 0 ] }}"
        }
      },
      "credentials": { "postgres": { "id": "LhLeadsPostgres1", "name": "Leads Postgres" } }
    }
  ],
  "connections": {
    "Chạy thủ công": { "main": [ [ { "node": "Run đang chạy", "type": "main", "index": 0 } ] ] },
    "5 phút/lần (23h–5h)": { "main": [ [ { "node": "Run đang chạy", "type": "main", "index": 0 } ] ] },
    "Run đang chạy": { "main": [ [ { "node": "Hỏi trạng thái run", "type": "main", "index": 0 } ] ] },
    "Hỏi trạng thái run": { "main": [ [ { "node": "Theo trạng thái", "type": "main", "index": 0 } ] ] },
    "Theo trạng thái": {
      "main": [
        [ { "node": "Tải kết quả", "type": "main", "index": 0 } ],
        [ { "node": "Đánh dấu job lỗi", "type": "main", "index": 0 } ]
      ]
    },
    "Tải kết quả": {
      "main": [
        [ { "node": "Lưu lead vào DB", "type": "main", "index": 0 } ],
        [ { "node": "Đánh dấu job lỗi", "type": "main", "index": 0 } ]
      ]
    },
    "Lưu lead vào DB": {
      "main": [
        [],
        [ { "node": "Đánh dấu job lỗi", "type": "main", "index": 0 } ]
      ]
    }
  }
}
