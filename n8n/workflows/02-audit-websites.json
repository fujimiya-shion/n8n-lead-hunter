    {
      "id": "b1b2c3d4-0002-4000-8000-000000000008",
      "name": "Phân tích HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Lấy web cần audit').item.json;\nconst r = $json;\nconst raw = r.data ?? r.body;\nconst html = typeof raw === 'string' ? raw : '';\nconst status = r.statusCode ?? null;\nconst reachable = !r.error && status !== null && status < 400 && html.length > 200;\n\nconst uniq = a => [...new Set(a)];\nconst noScript = html.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ').replace(/<style[\\s\\S]*?<\\/style>/gi, ' ');\nconst plain = noScript.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ');\nconst hrefs = (html.match(/href\\s*=\\s*[\"'][^\"']+[\"']/gi) || []).map(h => h.replace(/^href\\s*=\\s*[\"']/i, '').slice(0, -1));\n\n// Email: text + mailto:\nconst emails = uniq([\n  ...(noScript.match(/[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}/gi) || []),\n  ...hrefs.filter(h => /^mailto:/i.test(h)).map(h => h.replace(/^mailto:/i, '').split('?')[0])\n].map(e => e.toLowerCase())).slice(0, 10);\n\n// SĐT VN: text + tel:\nconst phones = uniq([\n  ...(plain.match(/(?:\\+84|\\b0)(?:[\\s.\\-]?\\d){9,10}\\b/g) || []),\n  ...hrefs.filter(h => /^tel:/i.test(h)).map(h => h.replace(/^tel:/i, ''))\n].map(p => p.replace(/[^\\d+]/g, ''))).slice(0, 10);\n\nconst facebooks = uniq(hrefs.filter(u => /^https?:\\/\\/(www\\.|m\\.)?facebook\\.com\\/(?!sharer|share|plugins|dialog|tr\\b)/i.test(u))).slice(0, 3);\nconst zalos = uniq(hrefs.filter(u => /^https?:\\/\\/zalo\\.me\\//i.test(u))).slice(0, 3);\n\n// Năm copyright mới nhất\nconst yrs = [...plain.matchAll(/(?:©|&copy;|copyright)[^0-9]{0,40}((?:19|20)\\d{2})(?:\\s*[-–]\\s*((?:19|20)\\d{2}))?/gi)]\n  .map(m => Number(m[2] || m[1])).filter(y => y <= new Date().getFullYear());\n\nconst cmsRules = [\n  ['WordPress', /wp-content|wp-includes/i], ['Wix', /wix\\.com|wixstatic/i],\n  ['Haravan', /haravan/i], ['Sapo', /sapo\\.vn|bizweb/i], ['LadiPage', /ladipage|ladicdn/i],\n  ['Shopify', /cdn\\.shopify/i], ['Joomla', /joomla/i], ['Blogspot', /blogger\\.com|blogspot/i],\n  ['Webflow', /webflow/i], ['Next.js', /__next/i], ['Nuxt', /__nuxt/i], ['Squarespace', /squarespace/i]\n];\nconst cms = (cmsRules.find(([, re]) => re.test(html)) || [null])[0];\nconst title = ((html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1] || '').trim();\n\nreturn { json: { id: src.id, website_url: src.website_url, audit: {\n  reachable,\n  status_code: status,\n  has_ssl: reachable ? r.has_ssl : null,\n  is_mobile_friendly: reachable ? /<meta[^>]+name\\s*=\\s*[\"']viewport[\"']/i.test(html) : null,\n  copyright_year: yrs.length ? Math.max(...yrs) : null,\n  cms, page_title: title.slice(0, 300),\n  error: r.error ? JSON.stringify(r.error).slice(0, 500) : null,\n  emails, phones, facebooks, zalos\n} } };"
      }
    },
