    {
      "id": "b1b2c3d4-0002-4000-8000-000000000003",
      "name": "Lấy web cần audit",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.id, b.website_url\nFROM businesses b\nLEFT JOIN web_audit a ON a.business_id = b.id\nWHERE b.website_type = 'real'\n  AND (a.business_id IS NULL OR a.audited_at < now() - interval '90 days')\nORDER BY b.review_count DESC\nLIMIT 100;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "LhLeadsPostgres1",
          "name": "Leads Postgres"
        }
      }
    },
