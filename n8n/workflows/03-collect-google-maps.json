    {
      "id": "c1b2c3d4-0003-4000-8000-000000000005",
      "name": "Theo trạng thái",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "xong",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.Status }}",
                    "rightValue": "ok",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "lỗi",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $json.Status }}",
                    "rightValue": "failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000006",
      "name": "Tải CSV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "=http://gmaps:8080/api/v1/jobs/{{ $('Job đang chạy').item.json.external_id }}/download",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000007",
      "name": "CSV → JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Chuyển CSV của gosom sang cùng format với Apify để dùng chung hàm ingest_places()\nfunction parseCSV(t) {\n  const rows = []; let row = [], f = '', q = false;\n  for (let i = 0; i < t.length; i++) {\n    const c = t[i];\n    if (q) {\n      if (c === '\"') { if (t[i + 1] === '\"') { f += '\"'; i++; } else q = false; }\n      else f += c;\n    } else if (c === '\"') q = true;\n    else if (c === ',') { row.push(f); f = ''; }\n    else if (c === '\\n') { row.push(f); rows.push(row); row = []; f = ''; }\n    else if (c !== '\\r') f += c;\n  }\n  if (f !== '' || row.length) { row.push(f); rows.push(row); }\n  return rows;\n}\nconst tryJSON = s => { try { return JSON.parse(s); } catch { return null; } };\nconst num = s => (s === '' || s == null || isNaN(Number(s))) ? null : Number(s);\n\nconst rows = parseCSV(String($json.data || ''));\nconst head = rows.shift() || [];\nconst items = rows.filter(r => r.length > 1).map(r => {\n  const o = Object.fromEntries(head.map((h, i) => [h, r[i] ?? '']));\n  const ca = tryJSON(o.complete_address) || {};\n  return {\n    placeId: o.place_id,\n    title: o.title,\n    categoryName: o.category || null,\n    categories: o.category ? [o.category] : [],\n    address: o.address || null,\n    state: ca.state || ca.borough || null,\n    city: ca.city || null,\n    location: { lat: num(o.latitude), lng: num(o.longitude) },\n    phone: o.phone || null,\n    totalScore: num(o.review_rating),\n    reviewsCount: num(o.review_count) || 0,\n    website: o.website || null,\n    url: o.link || null,\n    emails: (o.emails || '').split(',').map(e => e.trim()).filter(Boolean),\n    permanentlyClosed: /permanently|vĩnh viễn/i.test(o.status || ''),\n    cid: o.cid || null\n  };\n});\n\nreturn { json: { job_id: $('Job đang chạy').item.json.job_id, count: items.length, items: JSON.stringify(items) } };"
      }
    },
    {
      "id": "c1b2c3d4-0003-4000-8000-000000000008",
      "name": "Lưu lead vào DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1440,
