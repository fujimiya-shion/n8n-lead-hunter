      "name": "Job đang chạy",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS job_id, external_id\nFROM crawl_jobs\nWHERE status = 'running' AND source = 'gosom_maps' AND external_id IS NOT NULL\nORDER BY id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "LhLeadsPostgres1",
          "name": "Leads Postgres"
        }
      }
    },
    {
