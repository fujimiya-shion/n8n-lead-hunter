        "query": "SELECT ingest_places($1::bigint, $2::jsonb) AS result FROM crawl_jobs WHERE id = $1::bigint AND status = 'running';",
        "options": {
          "queryReplacement": "={{ [ $json.job_id, $json.items ] }}"
        }
